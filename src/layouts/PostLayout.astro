---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  readingTime: number;
  prev?: { id: string; title: string } | null;
  next?: { id: string; title: string } | null;
}

const { post, readingTime, prev = null, next = null } = Astro.props;
const { title, date, description, tags, cover, coverAlt } = post.data;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={date}
  image={cover?.src}
>
  <article class="mx-auto max-w-3xl pt-5">
    <!-- Reading surface is near-solid: legibility beats glassiness here. -->
    <div class="glass-strong rounded-2xl px-5 py-7 sm:px-9 sm:py-10">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-sm font-medium no-underline hover:underline"
      >
        <span aria-hidden="true">&larr;</span> All posts
      </a>

      <header class="mt-5">
        <h1 class="text-2xl font-bold leading-tight tracking-tight sm:text-4xl">
          {title}
        </h1>

        <div
          class="mt-3 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[0.85rem] text-[var(--color-ink-faint)]"
        >
          <FormattedDate date={date} class="font-medium tabular-nums" />
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
        </div>

        {
          tags.length > 0 && (
            <ul class="mt-3.5 flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <li class="tag-chip">{tag}</li>
              ))}
            </ul>
          )
        }

        {
          cover && (
            <Image
              src={cover}
              alt={coverAlt ?? ''}
              widths={[600, 1200]}
              sizes="(min-width: 768px) 720px, 92vw"
              loading="eager"
              class="mt-6 w-full rounded-xl border border-white/60 object-cover"
            />
          )
        }
      </header>

      <hr class="my-7 border-0 border-t border-[rgb(15_23_42/0.1)]" />

      <div class="prose mx-auto">
        <slot />
      </div>
    </div>

    <!-- Prev / next -->
    {
      (prev || next) && (
        <nav class="mt-5 grid gap-4 sm:grid-cols-2" aria-label="More posts">
          {prev ? (
            <a
              href={`/blog/${prev.id}`}
              class="glass glass-hover rounded-xl p-4 no-underline"
            >
              <span class="text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-faint)]">
                Previous
              </span>
              <span class="mt-1 block font-medium text-[var(--color-ink)]">{prev.title}</span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )}

          {next && (
            <a
              href={`/blog/${next.id}`}
              class="glass glass-hover rounded-xl p-4 text-right no-underline"
            >
              <span class="text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-faint)]">
                Next
              </span>
              <span class="mt-1 block font-medium text-[var(--color-ink)]">{next.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
