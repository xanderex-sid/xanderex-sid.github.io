---
interface Props {
  date: Date;
  /** "long" → "12 October 2025", "short" → "Oct 2025" */
  format?: 'long' | 'short';
  class?: string;
}
const { date, format = 'long', class: className = '' } = Astro.props;

const opts: Intl.DateTimeFormatOptions =
  format === 'short'
    ? { month: 'short', year: 'numeric' }
    : { day: 'numeric', month: 'long', year: 'numeric' };

const label = new Intl.DateTimeFormat('en-GB', { ...opts, timeZone: 'UTC' }).format(date);
---

<time datetime={date.toISOString()} class={className}>{label}</time>
