---
/**
 * Progressive enhancement for Shiki output.
 *
 * astro.config.mjs stamps data-lang / data-filename / data-line-numbers onto
 * each <pre>. This wraps those in a .code-figure, adds the header bar (filename
 * + language) and a copy-to-clipboard button. Without JS the <pre> still
 * renders and scrolls — it just has no header.
 */
---

<script>
  const COPY_LABEL = 'Copy';
  const DONE_LABEL = 'Copied';

  function enhance(pre: HTMLPreElement) {
    if (pre.dataset.enhanced === 'true') return;
    pre.dataset.enhanced = 'true';

    const lang = pre.dataset.lang ?? 'text';
    const filename = pre.dataset.filename;

    const figure = document.createElement('figure');
    figure.className = 'code-figure';
    if (pre.dataset.lineNumbers === 'true') {
      figure.dataset.lineNumbers = 'true';
    }

    const header = document.createElement('figcaption');
    header.className = 'code-figure__header';

    const label = document.createElement('span');
    if (filename) {
      label.className = 'code-figure__name';
      label.textContent = filename;
    } else {
      label.className = 'code-figure__lang';
      label.textContent = lang;
    }

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.textContent = COPY_LABEL;
    button.setAttribute(
      'aria-label',
      filename ? `Copy code from ${filename}` : `Copy ${lang} code`
    );

    let resetTimer: number | undefined;
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        // Clipboard API needs a secure context; fall back to a temp selection.
        const ta = document.createElement('textarea');
        ta.value = code;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          // Deprecated, but it's the only fallback outside a secure context.
          // eslint-disable-next-line deprecation/deprecation
          (document as Document & { execCommand(c: string): boolean }).execCommand('copy');
        } catch {
          return;
        } finally {
          ta.remove();
        }
      }
      button.textContent = DONE_LABEL;
      button.dataset.copied = 'true';
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        button.textContent = COPY_LABEL;
        delete button.dataset.copied;
      }, 2000);
    });

    header.append(label, button);

    pre.parentNode?.insertBefore(figure, pre);
    figure.append(header, pre);
  }

  function run() {
    document
      .querySelectorAll<HTMLPreElement>('pre[data-lang]:not([data-enhanced])')
      .forEach(enhance);
  }

  run();
  document.addEventListener('astro:page-load', run);
</script>
