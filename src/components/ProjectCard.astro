---
import VideoBlock from './VideoBlock.astro';
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>['data'];
}
const { project } = Astro.props;
const { title, description, videoSrc, posterSrc, posterAlt, repoUrl, tags, comingSoon } =
  project;

// A block with no repo (e.g. the "coming soon" placeholder) is not a link.
const Tag = repoUrl ? 'a' : 'div';
const linkProps = repoUrl
  ? {
      href: repoUrl,
      target: '_blank',
      rel: 'noopener noreferrer',
      'aria-label': `${title} — open repository on GitHub (opens in a new tab)`,
    }
  : {};
---

<Tag
  {...linkProps}
  class:list={[
    'glass glass-hover group block rounded-2xl p-4 no-underline sm:p-5',
    comingSoon && 'border-dashed opacity-90',
  ]}
>
  <!-- Mobile: video on top, text below. Desktop: video left, text right. -->
  <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] md:items-center">
    <VideoBlock
      videoSrc={videoSrc}
      posterSrc={posterSrc}
      posterAlt={posterAlt}
      comingSoon={comingSoon}
    />

    <div class="min-w-0">
      <h3
        class="flex items-center gap-2 text-lg font-semibold tracking-tight text-[var(--color-ink)] sm:text-xl"
      >
        {title}
        {
          repoUrl && (
            <Icon
              name="external"
              size={15}
              class="shrink-0 text-[var(--color-ink-faint)] transition-colors group-hover:text-[var(--color-accent)]"
            />
          )
        }
      </h3>

      <p class="mt-2 text-[0.95rem] leading-relaxed text-[var(--color-ink-soft)]">
        {description}
      </p>

      {
        tags.length > 0 && (
          <ul class="mt-3.5 flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <li class="tag-chip">{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Tag>
