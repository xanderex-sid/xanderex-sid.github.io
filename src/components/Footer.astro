---
import SocialLinks from './SocialLinks.astro';
import { SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="px-3 pb-6 pt-12 sm:px-5">
  <div
    class="glass mx-auto flex max-w-5xl flex-col items-center gap-4 rounded-2xl px-5 py-5 text-center sm:flex-row sm:justify-between sm:text-left"
  >
    <p class="text-sm text-[var(--color-ink-muted)]">
      &copy; {year} {SITE.author}. Built with{' '}
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>.
    </p>
    <SocialLinks size={18} />
  </div>
</footer>
