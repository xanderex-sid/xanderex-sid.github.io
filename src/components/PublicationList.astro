---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'publications'>[];
}
const { items } = Astro.props;
---

<ol class="flex flex-col gap-6">
  {
    items.map((pub) => (
      <li class="border-l-2 border-[var(--color-accent)] pl-4">
        {/* Full citation: authors — title — venue — year */}
        <p class="text-[0.9rem] leading-relaxed text-[var(--color-ink-muted)]">
          {pub.data.authors.map((author, i) => (
            /* prettier-ignore — kept on one line so JSX doesn't insert a space before the comma */
            <>{i > 0 ? ', ' : ''}<span class:list={[author === pub.data.highlightAuthor && 'font-semibold text-[var(--color-ink)] underline decoration-[var(--color-accent)] decoration-2 underline-offset-2']}>{author}</span></>
          ))}
        </p>

        <h3 class="mt-1 text-[1.05rem] font-semibold leading-snug tracking-tight">
          {pub.data.title}
        </h3>

        <p class="mt-1 text-[0.9rem] italic leading-relaxed text-[var(--color-ink-muted)]">
          {pub.data.venue}, {pub.data.year}.
        </p>

        {pub.data.doi && (
          <p class="mt-0.5 font-mono text-[0.78rem] text-[var(--color-ink-faint)]">
            DOI: {pub.data.doi}
          </p>
        )}

        {pub.data.links.length > 0 && (
          <ul class="mt-2.5 flex flex-wrap gap-2">
            {pub.data.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center rounded-md border border-[rgb(17_94_89/0.28)] bg-[var(--color-accent-soft)] px-2.5 py-1 text-xs font-semibold text-[#0f4c47] no-underline transition-colors hover:bg-white"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )}

        {pub.data.note && (
          <p class="mt-3 rounded-md border border-dashed border-amber-500/50 bg-amber-50/70 px-3 py-2 text-[0.8rem] leading-relaxed text-amber-900">
            {pub.data.note}
          </p>
        )}
      </li>
    ))
  }
</ol>
