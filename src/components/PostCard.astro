---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  readingTime: number;
}
const { post, readingTime } = Astro.props;
const { title, date, description, tags, cover, coverAlt } = post.data;
---

<article class="glass glass-hover rounded-2xl">
  <a href={`/blog/${post.id}`} class="block h-full rounded-2xl p-4 no-underline sm:p-5">
    {
      cover && (
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[400, 800]}
          sizes="(min-width: 768px) 45vw, 92vw"
          loading="lazy"
          class="mb-4 aspect-[2/1] w-full rounded-xl border border-white/60 object-cover"
        />
      )
    }

    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[0.8rem] text-[var(--color-ink-faint)]">
      <FormattedDate date={date} class="font-medium tabular-nums" />
      <span aria-hidden="true">·</span>
      <span>{readingTime} min read</span>
    </div>

    <h2 class="mt-2 text-lg font-semibold leading-snug tracking-tight text-[var(--color-ink)] sm:text-xl">
      {title}
    </h2>

    <p class="mt-2 text-[0.95rem] leading-relaxed text-[var(--color-ink-soft)]">
      {description}
    </p>

    {
      tags.length > 0 && (
        <ul class="mt-3.5 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li class="tag-chip">{tag}</li>
          ))}
        </ul>
      )
    }
  </a>
</article>
